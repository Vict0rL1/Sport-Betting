# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Environment / secrets — never commit real API keys
.env
.env.local
.env.*.local

# Local data store and downloaded raw data (regenerated by `npm run update-data` / `npm run seed`)
data/tennis.db
data/tennis.db-*
# Fase 2: dos ficheros. ledger.db es lo tuyo (apuestas, predicciones registradas, precios
# observados) y NUNCA se sube; history.db se vuelve a bajar o a reconstruir.
data/history.db
data/history.db-*
data/history.export.db
data/ledger.db
data/ledger.db-*
data/ledger.db.antes-de-restaurar-*
data/*.pre-split-*
data/backups/
data/archive/
data/raw/*
!data/raw/.gitkeep
# The seed dataset under data/seed/ IS committed on purpose (offline demo data)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

