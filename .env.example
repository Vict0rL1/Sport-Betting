# Copia este archivo a .env y rellena tus keys. NUNCA subas .env al repo.

# Finnhub — https://finnhub.io/dashboard  (~60 llamadas/min en tier gratuito)
FINNHUB_API_KEY=

# Twelve Data — https://twelvedata.com/account/api-keys  (~800 llamadas/día)
TWELVEDATA_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key  (~25 llamadas/día)
ALPHAVANTAGE_API_KEY=

# FRED (St. Louis Fed) — https://fred.stlouisfed.org/docs/api/api_key.html  (gratis)
FRED_API_KEY=

# Anthropic (capa de interpretación LLM, Fase 3) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude (opcional). Por defecto claude-sonnet-5-5; alternativa:
# claude-opus-5-5, más capaz y el doble de caro.
# CLAUDE_MODEL=claude-sonnet-5-5

# SEC EDGAR no requiere key, pero exige identificarse en el User-Agent.
# Pon tu nombre y email reales (requisito de la SEC para uso justo de su API):
EDGAR_USER_AGENT="Nombre Apellido email@ejemplo.com"

# Ruta de la base de datos SQLite (opcional; por defecto backend/data/app.db).
# Absoluta, o relativa a backend/ (el backend arranca ahí): «data/app.db», no
# «backend/data/app.db», que acabaría en backend/backend/data/.
# DATABASE_PATH=data/app.db
