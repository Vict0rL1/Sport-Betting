{
  "permissions": {
    "deny": [
      "Bash(npm run odds *)",
      "Bash(npm run restore *)",
      "Bash(npm run fetch-data *--force*)",
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(*--unlock*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-update.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
